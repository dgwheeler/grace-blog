---
import { TURNSTILE_SITEKEY } from '../consts';

interface Props {
	slug: string;
}

const { slug } = Astro.props;
---

<section class="comments" data-slug={slug} data-sitekey={TURNSTILE_SITEKEY}>
	<h2>Comments</h2>
	<p class="comments-status" role="status">Loading comments…</p>
	<ol class="comments-list"></ol>

	<form class="comment-form" hidden>
		<label>Name<input name="author" maxlength="60" required /></label>
		<label>Email (optional, never shown)<input name="email" type="email" maxlength="200" /></label>
		<label>Comment<textarea name="body" maxlength="4000" rows="5" required></textarea></label>
		{TURNSTILE_SITEKEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY}></div>}
		<button type="submit">Post comment</button>
		<p class="form-status" role="status"></p>
	</form>
</section>

{TURNSTILE_SITEKEY && <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}

<style>
	.comments { max-width: 620px; margin: 3rem auto 0; }
	.comments h2 { font-size: 1.2rem; margin-bottom: 1rem; }
	.comments-list { list-style: none; padding: 0; margin: 0 0 2rem; }
	.comments-list li { border-top: 1px solid #e5e5e5; padding: 1rem 0; }
	.comment-author { font-weight: 600; }
	.comment-date { color: #767676; font-size: 0.8rem; margin-left: 0.5rem; }
	.comment-body { white-space: pre-wrap; margin: 0.4rem 0 0; }
	.comment-form { display: flex; flex-direction: column; gap: 0.75rem; }
	.comment-form label { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.85rem; }
	.comment-form input, .comment-form textarea { font: inherit; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; }
	.comment-form button { align-self: flex-start; padding: 0.5rem 1rem; font: inherit; cursor: pointer; }
	.form-status:empty { display: none; }
</style>

<script>
	// Astro bundles this as a module, where document.currentScript is null — find the section
	// directly. One post page renders exactly one Comments component.
	const root = document.querySelector('.comments');
	const slug = root.dataset.slug;
	const list = root.querySelector('.comments-list');
	const status = root.querySelector('.comments-status');
	const form = root.querySelector('.comment-form');
	const formStatus = root.querySelector('.form-status');

	function render(comments) {
		list.replaceChildren();
		for (const c of comments) {
			const li = document.createElement('li');
			const head = document.createElement('p');
			const name = document.createElement('span');
			name.className = 'comment-author';
			name.textContent = c.author;
			const when = document.createElement('span');
			when.className = 'comment-date';
			when.textContent = new Date(c.created_at).toLocaleDateString();
			head.append(name, when);
			const body = document.createElement('p');
			body.className = 'comment-body';
			body.textContent = c.body;
			li.append(head, body);
			list.append(li);
		}
	}

	async function load() {
		try {
			const res = await fetch(`/api/comments?slug=${encodeURIComponent(slug)}`);
			const data = await res.json();
			const comments = data.comments ?? [];
			render(comments);
			status.textContent = comments.length ? '' : 'No comments yet.';
		} catch {
			status.textContent = 'Comments could not be loaded.';
		}
		form.hidden = false;
	}

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		const button = form.querySelector('button');
		button.disabled = true;
		formStatus.textContent = '';
		const data = new FormData(form);
		try {
			const res = await fetch('/api/comments', {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({
					slug,
					author: data.get('author'),
					email: data.get('email'),
					body: data.get('body'),
					token: data.get('cf-turnstile-response') ?? '',
				}),
			});
			if (res.status === 201) {
				form.reset();
				formStatus.textContent = 'Thank you. Your comment will appear once it has been read.';
			} else if (res.status === 429) {
				formStatus.textContent = 'That is a lot of comments at once. Try again in a minute.';
			} else if (res.status === 403) {
				formStatus.textContent = 'The spam check did not pass. Reload the page and try again.';
			} else {
				formStatus.textContent = 'That comment could not be posted. Check the fields and try again.';
			}
		} catch {
			formStatus.textContent = 'That comment could not be posted.';
		} finally {
			button.disabled = false;
			if (globalThis.turnstile) globalThis.turnstile.reset();
		}
	});

	load();
</script>
